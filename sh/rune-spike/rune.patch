 //! Making a GPU device ahead of a surface (`warm_gpu`) and looking at the GPUs once at launch
 //! (`probe_gpu`), so a first surface waits less for its device.
 
+/// The device an app opened itself, which every surface and headless run draws with.
+static ADOPTED: std::sync::Mutex<Option<super::Gpu>> = std::sync::Mutex::new(None);
+
+/// Draws every window, overlay and headless run with `gpu`, a device the app opened itself, so
+/// textures the app renders on it draw in Rune's frames without leaving the GPU. Call it before
+/// the app runs. A surface still checks that `gpu`'s adapter presents to it.
+pub fn adopt_gpu(gpu: super::Gpu) {
+    *ADOPTED.lock().unwrap_or_else(|e| e.into_inner()) = Some(gpu);
+}
+
+/// The device `adopt_gpu` gave, if any.
+pub(crate) fn adopted_gpu() -> Option<super::Gpu> {
+    let adopted = ADOPTED.lock().unwrap_or_else(|e| e.into_inner());
+    adopted.as_ref().map(|gpu| super::Gpu {
+        instance: gpu.instance.clone(),
+        adapter: gpu.adapter.clone(),
+        device: gpu.device.clone(),
+        queue: gpu.queue.clone(),
+    })
+}
+
