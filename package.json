{
	"name": "studio",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"//workspaces": "The join page builds on the moq submodule's packages, like the Rust crates, so it never waits on a moq release. Every @moq package it reaches is listed, since a workspace resolves only workspace packages.",
	"workspaces": [
		"js/join",
		"moq/js/clock",
		"moq/js/e2ee",
		"moq/js/hang",
		"moq/js/json",
		"moq/js/libav",
		"moq/js/loc",
		"moq/js/msf",
		"moq/js/net",
		"moq/js/pattern",
		"moq/js/publish",
		"moq/js/qmux",
		"moq/js/room",
		"moq/js/signals",
		"moq/js/ui",
		"moq/js/video",
		"moq/js/watch"
	],
	"scripts": {
		"postinstall": "bun run --cwd moq/js/libav build",
		"check": "bun run --filter='./js/*' check",
		"test": "bun run --filter='./js/*' test",
		"fix": "bun biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4"
	}
}
