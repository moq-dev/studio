// moq's settings, so the join page reads like moq's own packages.
{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Only the JavaScript. `!!moq` keeps the submodule out of the scan, whose
		// own root config biome would otherwise refuse.
		"includes": ["js/**", "package.json", "biome.jsonc", "!!moq"]
	},
	"formatter": {
		"lineWidth": 120,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf"
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noImportCycles": {
					"level": "error",
					"options": {
						"ignoreTypes": true
					}
				}
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"yaml": {
		"formatter": {
			"enabled": false
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	}
}
